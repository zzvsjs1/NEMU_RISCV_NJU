diff --git a/include/sys/config.h b/include/sys/config.h
index 5a3d593f7..6724758aa 100644
--- a/include/sys/config.h
+++ b/include/sys/config.h
@@ -4,6 +4,21 @@
 #include <machine/ieeefp.h>  /* floating point macros */
 #include <sys/features.h>	/* POSIX defs */
 
+/*
+ * Navy selects the active newlib reentrancy record through __getreent().
+ * libos preserves the historical global record until its MT runtime is
+ * explicitly enabled, so this is compatible with existing single-threaded
+ * applications as well as the new threaded target.
+ */
+#if defined(__NAVY__)
+#ifndef __DYNAMIC_REENT__
+#define __DYNAMIC_REENT__
+#endif
+#ifndef _REENT_GLOBAL_STDIO_STREAMS
+#define _REENT_GLOBAL_STDIO_STREAMS
+#endif
+#endif
+
 #ifdef __aarch64__
 #define MALLOC_ALIGNMENT 16
 #endif
diff --git a/include/sys/lock.h b/include/sys/lock.h
index 13b03dbf7..19e7fd8ab 100644
--- a/include/sys/lock.h
+++ b/include/sys/lock.h
@@ -6,7 +6,48 @@
 #include <newlib.h>
 #include <_ansi.h>
 
-#if !defined(_RETARGETABLE_LOCKING)
+#if defined(__NAVY__)
+
+/*
+ * Navy mutex identity is the stable address of the newlib lock object.  The
+ * integer stored there remains deliberately opaque: initialisation and close
+ * do not need kernel operations, and libos makes acquire/release no-ops until
+ * a threading library explicitly activates the MT runtime.
+ */
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern int nanos_lock_acquire(const void *key, bool recursive, bool try_only);
+extern int nanos_lock_release(const void *key);
+
+#ifdef __cplusplus
+}
+#endif
+
+typedef int _LOCK_T;
+typedef int _LOCK_RECURSIVE_T;
+
+#define __LOCK_INIT(class,lock) class int lock = 0;
+#define __LOCK_INIT_RECURSIVE(class,lock) class int lock = 0;
+#define __lock_init(lock) ((void) 0)
+#define __lock_init_recursive(lock) ((void) 0)
+#define __lock_close(lock) ((void) 0)
+#define __lock_close_recursive(lock) ((void) 0)
+#define __lock_acquire(lock) \
+  ((void)nanos_lock_acquire(&(lock), false, false))
+#define __lock_acquire_recursive(lock) \
+  ((void)nanos_lock_acquire(&(lock), true, false))
+#define __lock_try_acquire(lock) \
+  (nanos_lock_acquire(&(lock), false, true) == 0)
+#define __lock_try_acquire_recursive(lock) \
+  (nanos_lock_acquire(&(lock), true, true) == 0)
+#define __lock_release(lock) ((void)nanos_lock_release(&(lock)))
+#define __lock_release_recursive(lock) ((void)nanos_lock_release(&(lock)))
+
+#elif !defined(_RETARGETABLE_LOCKING)
 
 typedef int _LOCK_T;
 typedef int _LOCK_RECURSIVE_T;
diff --git a/src/reent/getreent.c b/src/reent/getreent.c
index 4140de6a7..5212e72e9 100644
--- a/src/reent/getreent.c
+++ b/src/reent/getreent.c
@@ -13,10 +13,23 @@ int _dummy_getreent;
 #undef __getreent
 #endif
 
+#ifdef __NAVY__
+/*
+ * libos owns the activation policy and per-thread record table.  Keeping that
+ * policy outside newlib lets existing single-threaded Navy binaries continue
+ * to use _impure_ptr without making MT-only syscalls.
+ */
+extern struct _reent *__nanos_getreent (void);
+#endif
+
 struct _reent *
 __getreent (void)
 {
+#ifdef __NAVY__
+  return __nanos_getreent ();
+#else
   return _impure_ptr;
+#endif
 }
 
 #endif
